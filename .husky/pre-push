#!/usr/bin/env sh

# Build: full monorepo build (mirrors CI pre-command)
bun run build 2>&1
BUILD_EXIT=$?
if [ $BUILD_EXIT -ne 0 ]; then
  echo "❌ pre-push FAILED: Build errors detected."
  exit 1
fi

# L1: Unit Tests ≥90% coverage
bun run test:coverage 2>&1
TEST_EXIT=$?
if [ $TEST_EXIT -ne 0 ]; then
  echo "❌ pre-push FAILED: Unit tests or coverage threshold (90%) not met."
  exit 1
fi

# G1: TypeScript type check
bun run lint 2>&1
LINT_EXIT=$?
if [ $LINT_EXIT -ne 0 ]; then
  echo "❌ pre-push FAILED: TypeScript type check errors."
  exit 1
fi

# G1: Biome lint + format
bunx biome check packages/ 2>&1
BIOME_EXIT=$?
if [ $BIOME_EXIT -ne 0 ]; then
  echo "❌ pre-push FAILED: Biome lint/format violations found."
  exit 1
fi

# G2: Secret scanning
bun run lint:secrets 2>&1
SECRETS_EXIT=$?
if [ $SECRETS_EXIT -ne 0 ]; then
  echo "❌ pre-push FAILED: Secrets detected by gitleaks."
  exit 1
fi

# G2: Dependency audit
bun run lint:deps 2>&1
DEPS_EXIT=$?
if [ $DEPS_EXIT -ne 0 ]; then
  echo "❌ pre-push FAILED: Known vulnerabilities detected by osv-scanner."
  exit 1
fi

# L2: API E2E Tests
bun run test:e2e 2>&1
E2E_EXIT=$?
if [ $E2E_EXIT -ne 0 ]; then
  echo "❌ pre-push FAILED: E2E API tests failed."
  exit 1
fi

echo "✅ pre-push passed: Build + L1 + L2 + G1 (tsc + Biome) + G2 (gitleaks + osv-scanner)"
