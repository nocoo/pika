#!/usr/bin/env sh
. "$(dirname "$0")/../scripts/ensure-tools.sh" bun gitleaks osv-scanner npx

# ── parallel stage helpers ──────────────────────────────────────
STAGE_DIR=$(mktemp -d)
trap 'rm -rf "$STAGE_DIR"' EXIT

run_bg() {
  local name="$1"; shift
  "$@" >"$STAGE_DIR/$name.log" 2>&1 &
  echo $! > "$STAGE_DIR/$name.pid"
}

wait_stage() {
  local name="$1"
  local pid
  pid=$(cat "$STAGE_DIR/$name.pid")
  if ! wait "$pid"; then
    echo "❌ pre-push FAILED: $name"
    cat "$STAGE_DIR/$name.log"
    exit 1
  fi
}

# ── Build (sequential — L2 needs built assets) ─────────────────
bun run build 2>&1
BUILD_EXIT=$?
if [ $BUILD_EXIT -ne 0 ]; then
  echo "❌ pre-push FAILED: Build errors detected."
  exit 1
fi

# ── L2: Worker E2E + G2: Security (parallel) ───────────────────
run_bg "l2-e2e" bun run test:e2e
run_bg "g2-secrets" bun run lint:secrets
run_bg "g2-deps" bun run lint:deps

wait_stage "l2-e2e"
wait_stage "g2-secrets"
wait_stage "g2-deps"

echo "✅ pre-push passed: Build + L2 (E2E) + G2 (gitleaks + osv-scanner)"
