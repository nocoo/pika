#!/usr/bin/env sh

# Parallelize all pre-push gates. Every gate is independent of the others, so
# wall-clock is dominated by the slowest one (`bun run build`) instead of the
# sum.
#
# Implementation: launch each gate as a background job that writes its log to a
# tmpfile and signals completion via a status file. Wait for all, then dump
# logs only for failures so successful runs stay quiet (matches the original
# UX). Any failure → exit 1 with the offending log inline.

set -u

TMP=$(mktemp -d -t pika-prepush-XXXXXX)
trap 'rm -rf "$TMP"' EXIT

# Optional per-phase timing dir (set by the autoresearch bench).
PHASE_DIR="${PIKA_PHASE_DIR:-}"

run_gate() {
  name="$1"; shift
  cmd="$*"
  (
    t1=$(date +%s%N 2>/dev/null || python3 -c 'import time;print(int(time.time()*1e9))')
    sh -c "$cmd" >"$TMP/$name.log" 2>&1
    rc=$?
    t2=$(date +%s%N 2>/dev/null || python3 -c 'import time;print(int(time.time()*1e9))')
    echo $rc >"$TMP/$name.rc"
    if [ -n "$PHASE_DIR" ]; then
      echo $(( (t2 - t1) / 1000000 )) >"$PHASE_DIR/$name.ms"
    fi
  ) &
}

# Launch all gates concurrently.
run_gate build      "bun run build"
run_gate tests      "bun run test:coverage"
run_gate tsc        "bun run lint"
run_gate biome      "bunx biome check packages/"
run_gate secrets    "bun run lint:secrets"
run_gate deps       "bun run lint:deps"
if [ "${PIKA_SKIP_E2E:-0}" != "1" ]; then
  run_gate e2e        "bun run test:e2e"
fi

# Wait for everything to finish (don't fail-fast — we want all logs).
wait

FAILED=0

report() {
  name="$1"; label="$2"
  rc=$(cat "$TMP/$name.rc" 2>/dev/null || echo 1)
  if [ "$rc" -ne 0 ]; then
    echo ""
    echo "❌ pre-push FAILED: $label"
    echo "--- $name output ---"
    cat "$TMP/$name.log"
    echo "--- end $name ---"
    FAILED=1
  fi
}

report build   "Build errors detected."
report tests   "Unit tests or coverage threshold (90%) not met."
report tsc     "TypeScript type check errors."
report biome   "Biome lint/format violations found."
report secrets "Secrets detected by gitleaks."
report deps    "Known vulnerabilities detected by osv-scanner."
if [ "${PIKA_SKIP_E2E:-0}" != "1" ]; then
  report e2e     "E2E API tests failed."
fi

if [ "$FAILED" -ne 0 ]; then
  exit 1
fi

echo "✅ pre-push passed: Build + L1 + L2 + G1 (tsc + Biome) + G2 (gitleaks + osv-scanner)"
