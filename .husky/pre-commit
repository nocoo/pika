#!/usr/bin/env sh

# Run L1 unit tests + G1 Biome lint in parallel — they are independent.

set -u

TMP=$(mktemp -d -t pika-precommit-XXXXXX)
trap 'rm -rf "$TMP"' EXIT

run_gate() {
  name="$1"; shift
  cmd="$*"
  (
    sh -c "$cmd" >"$TMP/$name.log" 2>&1
    echo $? >"$TMP/$name.rc"
  ) &
}

run_gate tests "bun run test:coverage"
run_gate biome "bunx biome check packages/"

wait

FAILED=0
report() {
  name="$1"; label="$2"
  rc=$(cat "$TMP/$name.rc" 2>/dev/null || echo 1)
  if [ "$rc" -ne 0 ]; then
    echo ""
    echo "❌ pre-commit FAILED: $label"
    echo "--- $name output ---"
    cat "$TMP/$name.log"
    echo "--- end $name ---"
    FAILED=1
  fi
}

report tests "Unit tests or coverage threshold (90%) not met."
report biome "Biome lint/format violations found."

if [ "$FAILED" -ne 0 ]; then
  exit 1
fi

echo "✅ pre-commit passed: L1 (UT ≥90%) + G1 (Biome)"
