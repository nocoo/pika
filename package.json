{
  "name": "pika",
  "version": "0.8.6",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:web-worker",
    "dev:web": "bun run --cwd packages/web dev",
    "dev:web-worker": "bun run --cwd packages/web-worker dev",
    "dev:all": "bun scripts/dev-all.ts",
    "build": "bun run --filter '*' build",
    "build:web": "bun run --cwd packages/web build",
    "deploy:web-worker": "bun run --cwd packages/web-worker deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run --cwd packages/web-worker test:e2e",
    "lint": "tsc --noEmit && tsc --noEmit -p packages/web/tsconfig.json && tsc --noEmit -p packages/web-worker/tsconfig.json",
    "lint:typecheck": "tsc --noEmit && tsc --noEmit -p packages/web/tsconfig.json && tsc --noEmit -p packages/web-worker/tsconfig.json",
    "lint:biome": "bunx biome check packages/",
    "lint:secrets": "gitleaks detect --source . --no-git --config .gitleaks.toml",
    "lint:deps": "osv-scanner scan --lockfile=bun.lock --config .osv-scanner.toml",
    "lint:all": "bun run lint && bunx biome check packages/ && bun run lint:secrets && bun run lint:deps",
    "sync-versions": "bun scripts/sync-versions.ts --write",
    "prepare": "husky",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/web/tsconfig.json && tsc --noEmit -p packages/web-worker/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@vitest/coverage-v8": "^4.1.9",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "undici": "^7.28.0",
    "cookie": ">=0.7.0",
    "picomatch": ">=4.0.4",
    "fast-xml-parser": ">=5.7.0",
    "fast-xml-builder": ">=1.1.7",
    "postcss": ">=8.5.10",
    "ws": ">=8.21.0",
    "esbuild": ">=0.28.1"
  },
  "dependencies": {
    "brace-expansion": "^5.0.7",
    "vite": "8.1.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "biome check --error-on-warnings --no-errors-on-unmatched"
    ]
  }
}
